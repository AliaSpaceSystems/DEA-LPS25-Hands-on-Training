[{"id":"document","name":"Vienna","version":"1.0"},{"id":"site-Historic_Centre_of_Vienna_(UNESCO)","name":"Historic Centre of Vienna (UNESCO)","position":{"cartographicDegrees":[16.37208,48.20849,0]},"label":{"text":"Historic Centre of Vienna (UNESCO)","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='\thttps://whc.unesco.org/uploads/thumbs/site_1033_0006-750-750-20151104154612.jpg' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> The Historic Centre of Vienna is a UNESCO World Heritage Site known for its rich architectural ensembles, including Baroque castles, gardens, and the late-19th-century Ringstraße.<br>\n            <b></b><br>\n            <b>Federal State:</b> Wien<br>\n            <b>District:</b> Innere Stadt<br>\n            <b>More info on the area:</b> <a href=\"https://whc.unesco.org/en/list/1033/\" target=\"_blank\">https://whc.unesco.org/en/list/1033/</a>\n        </div>\n    </div>\n    "},{"id":"site-Palace_and_Gardens_of_Schönbrunn_(UNESCO)","name":"Palace and Gardens of Schönbrunn (UNESCO)","position":{"cartographicDegrees":[16.3122,48.1845,0]},"label":{"text":"Palace and Gardens of Schönbrunn (UNESCO)","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='https://upload.wikimedia.org/wikipedia/commons/thumb/8/83/Neptune_Fountain_Sch%C3%B6nbrunn.jpg/512px-Neptune_Fountain_Sch%C3%B6nbrunn.jpg' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> 18th‑century imperial Rococo complex with palace, gardens, and the world’s oldest zoo (Zoo‑Schonbrunn). UNESCO since 1996.<br>\n            <b></b><br>\n            <b>Federal State:</b> Vienna<br>\n            <b>District:</b> Hietzing<br>\n            <b>More info on the area:</b> <a href=\"https://whc.unesco.org/en/list/786/\" target=\"_blank\">https://whc.unesco.org/en/list/786/</a>\n        </div>\n    </div>\n    "},{"id":"site-Ferris_Wheel_Legacy","name":"Ferris Wheel Legacy","position":{"cartographicDegrees":[16.396,48.2167,0]},"label":{"text":"Ferris Wheel Legacy","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='https://upload.wikimedia.org/wikipedia/commons/thumb/3/30/Wien_Riesenrad.jpg/512px-Wien_Riesenrad.jpg' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> The Wiener Riesenrad, located in the Prater, is one of the world's oldest Ferris wheels and a symbol of Vienna.<br>\n            <b></b><br>\n            <b>Federal State:</b> Wien<br>\n            <b>District:</b> Breitenfurt, Liesing<br>\n            <b>More info on the area:</b> <a href=\"https://www.wien.info/en/see-do/prater/experience-prater-345598#11/48.2075/16.3747\" target=\"_blank\">https://www.wien.info/en/see-do/prater/experience-prater-345598#11/48.2075/16.3747</a>\n        </div>\n    </div>\n    "},{"id":"site-Wiener_Prater","name":"Wiener Prater","position":{"cartographicDegrees":[16.430054,48.194558,0]},"label":{"text":"Wiener Prater","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Wien_02_Prater_Mauthnerwasser_a.jpg/512px-Wien_02_Prater_Mauthnerwasser_a.jpg' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> The Prater is a large public park in Vienna, home to the famous Riesenrad Ferris wheel, meadows, forests, and sports facilities.<br>\n            <b></b><br>\n            <b>Federal State:</b> Wien<br>\n            <b>District:</b> Leopoldstadt<br>\n            <b>More info on the area:</b> <a href=\"https://de.wikipedia.org/wiki/Wiener_Prater\" target=\"_blank\">https://de.wikipedia.org/wiki/Wiener_Prater</a>\n        </div>\n    </div>\n    "},{"id":"site-Vienna_Woods_(Wienerwald)","name":"Vienna Woods (Wienerwald)","position":{"cartographicDegrees":[16.2,48.205,0]},"label":{"text":"Vienna Woods (Wienerwald)","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='https://upload.wikimedia.org/wikipedia/commons/8/8d/Wienerwald2.jpg' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> The Vienna Woods are a UNESCO biosphere reserve forming the northeastern foothills of the Alps, offering diverse habitats and traditional cultural landscapes.<br>\n            <b></b><br>\n            <b>Federal State:</b> Wien<br>\n            <b>District:</b> Various (e.g. Penzing, Liesing)<br>\n            <b>More info on the area:</b> <a href=\"https://www.bpww.at/en/node/82\" target=\"_blank\">https://www.bpww.at/en/node/82</a>\n        </div>\n    </div>\n    "},{"id":"site-Vienna_Congress_Center","name":"Vienna Congress Center","position":{"cartographicDegrees":[16.4093,48.2145,0]},"label":{"text":"Vienna Congress Center","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='https://upload.wikimedia.org/wikipedia/commons/thumb/5/52/Wien_-_Austria_Center.JPG/512px-Wien_-_Austria_Center.JPG' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> Austria Center Vienna (ACV) is the nation’s largest conference center, hosting global events and congresses in the heart of Vienna's Donau City.<br>\n            <b></b><br>\n            <b>Federal State:</b> Wien<br>\n            <b>District:</b> Leopoldstadt<br>\n            <b>More info on the area:</b> <a href=\"https://www.acv.at/\" target=\"_blank\">https://www.acv.at/</a>\n        </div>\n    </div>\n    "},{"id":"site-Grinzing_Wine_Village","name":"Grinzing Wine Village","position":{"cartographicDegrees":[16.333,48.255,0]},"label":{"text":"Grinzing Wine Village","font":"16px sans-serif","fillColor":{"rgba":[255,215,0,255]},"outlineColor":{"rgba":[0,0,0,255]},"outlineWidth":2,"style":"FILL_AND_OUTLINE","horizontalOrigin":"CENTER","verticalOrigin":"BOTTOM","pixelOffset":{"cartesian2":[0,-30]},"scale":1.0,"distanceDisplayCondition":{"distanceDisplayCondition":[0,1000000]}},"billboard":{"image":"data:image/png;base64,","scale":0.25,"verticalOrigin":"BOTTOM"},"description":"\n    <div style='min-height:360px; min-width:300px; text-align:center;'>\n        <img src='https://upload.wikimedia.org/wikipedia/en/e/e9/Grinzing_wappen.png' style='max-height:256px;'><br><br>\n        <div style='text-align:left; padding: 0 10px;'>\n            <b></b> Grinzing is a historic wine village in Vienna known for its centuries-old Heurigen (wine taverns) and traditional Viennese wine culture nestled in the vineyards.<br>\n            <b></b><br>\n            <b>Federal State:</b> Wien<br>\n            <b>District:</b> Döbling<br>\n            <b>More info on the area:</b> <a href=\"https://www.grinzland.com/heuriger-en\" target=\"_blank\">https://www.grinzland.com/heuriger-en</a>\n        </div>\n    </div>\n    "}]